{
  "name": "eris",
  "productName": "Eris",
  "version": "0.2.0",
  "description": "Eris — Solvionyx work browser (Spaces · Apps · VPN)",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": { "name": "Solviony Inc.", "email": "support@solviony.com" },
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.7.3",
    "nanoid": "^5.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^9.8.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "build": {
    "appId": "com.solviony.eris",
    "productName": "Eris",
    "directories": { "output": "release", "buildResources": "assets" },
    "publish": [{ "provider": "github", "owner": "solviony", "repo": "Eris" }],
    "extraMetadata": { "name": "eris", "productName": "Eris", "version": "0.2.0", "main": "out/main/index.js" },
    "files": ["out/**", "assets/**", "package.json"],
    "mac": { "target": ["dmg"], "icon": "assets/icons/512x512.png", "category": "public.app-category.productivity" },
    "win": { "target": ["nsis"], "icon": "assets/icons/256x256.png" },
    "linux": { "target": ["AppImage", "deb"], "category": "Network", "icon": "assets/icons", "maintainer": "Solviony Inc. <dev@solviony.com>" }
  }
}
